# .env.example — copy to .env and fill in real values for local development.
# NEVER commit .env or any file containing real secrets. (AGENTS.md rule 1)
# This file is safe to commit: it contains only placeholder values.

# ── Kafka ──────────────────────────────────────────────────────────────────── #
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=logs.raw

# ── Log Producer ───────────────────────────────────────────────────────────── #
# Override these per-container in docker-compose.yml (or K8s ConfigMap).
SERVICE_NAME=unknown-service
REGION=us-east-1
EVENTS_PER_SECOND=5
# Options: "" (normal) | latency_spike | error_burst | unusual_status
ANOMALY_MODE=

# ── Anomaly Detector (Phase 2) ─────────────────────────────────────────────── #
WINDOW_SECONDS=30
WINDOW_SLIDE_SECONDS=10
ANOMALY_MODEL_PATH=/app/models/isolation_forest.pkl

# ── TimescaleDB (Phase 3) ──────────────────────────────────────────────────── #
# Individual credentials (used by docker-compose.yml to build TIMESCALEDB_URL
# and to configure the timescaledb container's POSTGRES_* env vars).
# Replace <change-me> with a real password in your local .env — never commit it.
TIMESCALEDB_USER=driftwatch
TIMESCALEDB_PASSWORD=<change-me>
TIMESCALEDB_DB=driftwatch
# Full connection URL (assembled from the above; also accepted directly).
TIMESCALEDB_URL=postgresql://driftwatch:<change-me>@timescaledb:5432/driftwatch

# ── Grafana (Phase 3) ─────────────────────────────────────────────────────── #
# Local dev only — never commit a real password.
GRAFANA_ADMIN_PASSWORD=<change-me>


OPENAI_API_KEY=sk-proj-yourActualKeyHere